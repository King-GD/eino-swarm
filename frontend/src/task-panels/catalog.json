[
  {
    "id": "fofa-world-map",
    "version": "1",
    "name": "FOFA world map",
    "description": "Show collected network assets by country and update their geographic markers as local HTTP(S) liveness checks finish. Use for tasks that request a geographic collection and liveness view. Collection uses the configured local FOFA client.",
    "entry": "task-panels/fofa-world-map.html",
    "schema": {
      "type": "object",
      "required": [
        "collection",
        "assets_by_id",
        "probe",
        "results_by_id"
      ],
      "properties": {
        "collection": {
          "type": "object",
          "required": [
            "phase",
            "received",
            "discovered",
            "completeness"
          ],
          "properties": {
            "phase": {
              "type": "string"
            },
            "received": {
              "type": "integer",
              "minimum": 0
            },
            "discovered": {
              "type": "integer",
              "minimum": 0
            },
            "reported_total": {
              "type": "integer",
              "minimum": 0
            },
            "completeness": {
              "enum": [
                "unknown",
                "partial",
                "complete"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "assets_by_id": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "ip",
              "port",
              "protocol",
              "host",
              "country",
              "region",
              "city",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "ip": {
                "type": "string"
              },
              "protocol": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            }
          }
        },
        "probe": {
          "type": "object",
          "required": [
            "pending",
            "running",
            "responded",
            "no_response",
            "skipped",
            "interrupted"
          ],
          "properties": {
            "pending": {
              "type": "integer",
              "minimum": 0
            },
            "running": {
              "type": "integer",
              "minimum": 0
            },
            "responded": {
              "type": "integer",
              "minimum": 0
            },
            "no_response": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            },
            "interrupted": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "results_by_id": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "finished_at"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "status_code": {
                "type": "integer"
              },
              "elapsed_ms": {
                "type": "number",
                "minimum": 0
              },
              "error": {
                "type": "string"
              },
              "finished_at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "initial_state": {
      "collection": {
        "phase": "collecting",
        "received": 0,
        "discovered": 0,
        "completeness": "unknown"
      },
      "assets_by_id": {},
      "probe": {
        "pending": 0,
        "running": 0,
        "responded": 0,
        "no_response": 0,
        "skipped": 0,
        "interrupted": 0
      },
      "results_by_id": {}
    },
    "source": {
      "id": "fofa-world-map",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "max_assets": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "id": "easm-asset-portrait",
    "version": "1",
    "name": "EASM",
    "description": "Show an enterprise asset portrait: the confirmed organization, its related companies, domains, filings and certificates as a graph, with asset totals, attention trend and component distribution. Use when the user asks for an organization's external asset portrait. Confirm the subject first (ask the user when it is ambiguous), open this panel, then run its source once with that subject and, when available, an asset query; the source performs every lookup itself and reports per-step status.",
    "entry": "",
    "renderer": "native",
    "schema": {
      "type": "object",
      "required": [
        "schema_version",
        "title",
        "collection",
        "nodes",
        "edges",
        "heat",
        "components"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "title": {
          "$ref": "#/$defs/nonempty"
        },
        "query": {
          "type": "string"
        },
        "collection": {
          "type": "object",
          "required": [
            "status",
            "steps"
          ],
          "properties": {
            "status": {
              "enum": [
                "idle",
                "running",
                "done",
                "interrupted"
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "status"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "organizations",
                      "relations",
                      "branches",
                      "filings",
                      "asset_rules",
                      "certificates",
                      "summary",
                      "heat",
                      "components"
                    ]
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "running",
                      "done",
                      "failed",
                      "skipped",
                      "unavailable",
                      "interrupted"
                    ]
                  },
                  "code": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/nonempty"
              },
              "target": {
                "$ref": "#/$defs/nonempty"
              },
              "confirmed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "clues": {
              "$ref": "#/$defs/nonnegative"
            },
            "fofa_assets": {
              "$ref": "#/$defs/nonnegative"
            },
            "fofa_ips": {
              "$ref": "#/$defs/nonnegative"
            }
          },
          "additionalProperties": false
        },
        "heat": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "value"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "value": {
                "$ref": "#/$defs/nonnegative"
              }
            },
            "additionalProperties": false
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "count"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonempty"
              },
              "display_name": {
                "type": "string"
              },
              "count": {
                "$ref": "#/$defs/nonnegative"
              },
              "hot_days": {
                "type": "integer",
                "minimum": 0
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "hot",
                        "kev",
                        "cve"
                      ]
                    },
                    "summary": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "title"
                        ],
                        "properties": {
                          "title": {
                            "$ref": "#/$defs/nonempty"
                          },
                          "date": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "pattern": "^https://"
                          },
                          "detail": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "$defs": {
        "nonempty": {
          "type": "string",
          "minLength": 1
        },
        "nonnegative": {
          "type": "number",
          "minimum": 0
        },
        "node": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "label"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/nonempty"
            },
            "kind": {
              "enum": [
                "root",
                "company",
                "domain",
                "feature"
              ]
            },
            "featureKind": {
              "enum": [
                "org",
                "cert",
                "mx",
                "asn",
                "icp",
                "icon_hash",
                "ipc",
                "fid"
              ]
            },
            "label": {
              "$ref": "#/$defs/nonempty"
            },
            "ip_count": {
              "$ref": "#/$defs/nonnegative"
            },
            "detail": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "logo": {
                  "type": "string",
                  "pattern": "^(data:image/|https://)"
                },
                "website": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "region": {
                  "type": "string"
                },
                "industry": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "organizations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "count": {
                        "$ref": "#/$defs/nonnegative"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "basis": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "source"
                    ],
                    "properties": {
                      "source": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "via": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "registry_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "registry_name": {
                  "$ref": "#/$defs/nonempty"
                },
                "organization_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "status": {
                  "type": "string"
                },
                "share": {
                  "type": "string"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "kind",
                      "value"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "org",
                          "cert",
                          "mx",
                          "asn",
                          "icp",
                          "icon_hash",
                          "ipc",
                          "fid",
                          "domain"
                        ]
                      },
                      "value": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "node_id": {
                        "$ref": "#/$defs/nonempty"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "serial": {
                  "type": "string"
                },
                "issuer": {
                  "type": "string"
                },
                "not_before": {
                  "type": "string"
                },
                "not_after": {
                  "type": "string"
                },
                "is_valid": {
                  "type": "boolean"
                },
                "is_match": {
                  "type": "boolean"
                },
                "observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "host"
                    ],
                    "properties": {
                      "host": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "domain": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "source": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "is_valid": {
                        "type": "boolean"
                      },
                      "is_match": {
                        "type": "boolean"
                      },
                      "is_expired": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "subject_name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "if": {
            "properties": {
              "kind": {
                "const": "feature"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "featureKind"
            ]
          },
          "else": {
            "not": {
              "required": [
                "featureKind"
              ]
            }
          }
        }
      }
    },
    "initial_state": {
      "schema_version": 1,
      "title": "EASM",
      "collection": {
        "status": "idle",
        "steps": []
      },
      "nodes": [],
      "edges": [],
      "heat": [],
      "components": []
    },
    "source": {
      "id": "easm-asset-portrait",
      "input_schema": {
        "type": "object",
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "query": {
            "type": "string",
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "logo": {
            "type": "string",
            "pattern": "^(data:image/|https://)",
            "maxLength": 200000
          },
          "website": {
            "type": "string",
            "pattern": "^https?://",
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      }
    }
  }
]
